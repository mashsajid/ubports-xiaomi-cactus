[Unit]
Description=Power on MediaTek WMT Wi-Fi (creates wlan0) for cactus
After=lxc-android-config.service
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# wmt_launcher in the Android container loads the connectivity firmware and
# creates /dev/wmtWifi; writing "1" powers Wi-Fi on and registers wlan0.
ExecStart=/bin/sh -c 'for i in $(seq 1 60); do [ -c /dev/wmtWifi ] && break; sleep 1; done; for i in $(seq 1 10); do echo 1 > /dev/wmtWifi && break; sleep 2; done; for i in $(seq 1 20); do [ -e /sys/class/net/wlan0 ] && exit 0; sleep 1; done; exit 1'
ExecStop=/bin/sh -c 'echo 0 > /dev/wmtWifi'

[Install]
WantedBy=multi-user.target
