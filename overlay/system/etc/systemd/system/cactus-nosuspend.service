[Unit]
Description=Hold a kernel wakelock: system suspend/resume does not work yet on cactus (bring-up)
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo cactus-nosuspend > /sys/power/wake_lock'
ExecStop=/bin/sh -c 'echo cactus-nosuspend > /sys/power/wake_unlock'

[Install]
WantedBy=sysinit.target
